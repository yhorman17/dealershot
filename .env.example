# Browser-safe, injected by Vite at build time.
VITE_SUPABASE_URL=https://your-dealershot-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_dealershot_publishable_key

# Server runtime. SUPABASE_SERVICE_ROLE_KEY must never use a VITE_ prefix.
SUPABASE_URL=https://your-dealershot-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_dealershot_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_dealershot_server_only_secret_key

# Optional CLI/project metadata; the application does not read this variable.
SUPABASE_PROJECT_ID=your-dealershot-project-ref
